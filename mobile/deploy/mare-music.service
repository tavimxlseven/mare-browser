[Unit]
Description=Mare Music private library
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mare-music
Group=mare-music
WorkingDirectory=/srv/mare-music/app
EnvironmentFile=/etc/mare-music.env
Environment=PATH=/srv/mare-music/venv/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_CONFIG_HOME=/srv/mare-music/state/config
Environment=XDG_STATE_HOME=/srv/mare-music/state/runtime
Environment=XDG_CACHE_HOME=/srv/mare-music/state/cache
ExecStart=/srv/mare-music/venv/bin/python server.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mare-music/state
MemoryMax=550M

[Install]
WantedBy=multi-user.target
