[Unit]
Description=Noise Music isolated source browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noise-source
Group=noise-source-control
WorkingDirectory=/var/lib/noise-source
Environment=HOME=/var/lib/noise-source
Environment=PYTHONNOUSERSITE=1
Environment=NOISE_SOURCE_BROWSER_HOME=/var/lib/noise-source
Environment=NOISE_SOURCE_BROWSER_SOCKET=/run/noise-source/control.sock
ExecStart=/opt/noise-source/venv/bin/python /opt/noise-source/source_browser_daemon.py
Restart=on-failure
RestartSec=5
StateDirectory=noise-source
StateDirectoryMode=0700
RuntimeDirectory=noise-source
RuntimeDirectoryMode=0750
UMask=0077
KillMode=control-group
TimeoutStopSec=10
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noise-source /run/noise-source
MemoryHigh=500M
MemoryMax=650M
TasksMax=200

[Install]
WantedBy=multi-user.target
